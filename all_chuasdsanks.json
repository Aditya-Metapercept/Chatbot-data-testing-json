    {
      "chunk_id": "6aa8d6a3-5632-46b7-a88e-a111fb90ef1c",
      "section": "extraction.heroSections[0].content",
      "text": "Founded in 2010, Metapercept Technology Services has evolved from a generic technical writing firm into the industry's first AI-native documentation consultancy. We have helped over 300+ enterprise clients transform their content strategies, achieving an average 45% reduction in documentation costs while improving quality and compliance. From DITA-XML implementation to enterprise content systems and AI-powered documentation workflows, we deliver end-to-end solutions that enable scalability, compliance, and business growth.",
      "chunk_references": [
        "5af67i7e-g58j-895a-c6cg-eh3d3fh2a5ic"
      ]
    },
    {
